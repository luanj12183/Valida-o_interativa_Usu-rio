@{
    Layout = null;
    ViewData["Title"] = "Contador Interativo....";
}

<style>
    /* Zera qualquer margem ou padding do HTML pai */
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        background-color: #f4f7f6 !important;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* MENU LATERAL FIXO */
    .abas-navegacao {
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
        position: fixed !important;
        top: 40px !important;
        left: 40px !important;
        z-index: 99999 !important;
    }

    .abas-navegacao a {
        text-decoration: none;
        color: #777;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-align: left;    
    }

    .abas-navegacao a.ativa {
        background-color: #e0e5e4;
        color: #333;
    }

    .abas-navegacao a:hover:not(.ativa) {
        background-color: #eaeaea;
        color: #007bff;
    }

    /* CAIXA INDEPENDENTE FIXADA NO CENTRO ABSOLUTO DA TELA */
    .caixa-centro-absoluto {
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important; /* Move o bloco exatamente para o centro */
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
        z-index: 88888 !important;
    }

    #txtContador { 
        font-size: 96px !important; 
        font-weight: bold !important; 
        margin: 0 0 20px 0 !important;
        line-height: 1 !important;
    }

    .num-neutro { color: #333333 !important; }   
    .num-positivo { color: #28a745 !important; } 
    .num-negativo { color: #dc3545 !important; } 

    .grupo-botoes {
        display: flex !important;
        gap: 10px !important;
    }

    .btn-contador {
        padding: 10px 20px !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important;
        font-weight: 500 !important;
        font-size: 16px !important;
        cursor: pointer !important;
        transition: background-color 0.2s;
    }

    .btn-azul { background-color: #007bff !important; }
    .btn-azul:hover { background-color: #0069d9 !important; }

    .btn-cinza { background-color: #6c757d !important; }
    .btn-cinza:hover { background-color: #5a6268 !important; }
</style>

<div class="abas-navegacao">
    <a href="/">📄 Cadastro</a>
    <a href="/Home/Contador" class="ativa">🔢 Contador</a>
</div>

<div class="caixa-centro-absoluto">
    <div id="txtContador" class="num-neutro">0</div>

    <div class="grupo-botoes">
        <button class="btn-contador btn-azul" id="btnSomar">Incrementar</button>
        <button class="btn-contador btn-azul" id="btnDiminuir">Decrementar</button>
        <button class="btn-contador btn-cinza" id="btnZerar">Zerar</button>
    </div>
</div>

<script>
    let cliques = 0;
    const txtContador = document.getElementById("txtContador");
    const btnSomar = document.getElementById("btnSomar");
    const btnDiminuir = document.getElementById("btnDiminuir");
    const btnZerar = document.getElementById("btnZerar");

    function atualizarCor() {
        txtContador.classList.remove("num-neutro", "num-positivo", "num-negativo");
        if (cliques > 0) {
            txtContador.classList.add("num-positivo");
        } else if (cliques < 0) {
            txtContador.classList.add("num-negativo");
        } else {
            txtContador.classList.add("num-neutro");
        }
    }

    btnSomar.addEventListener("click", function() {
        cliques++;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnDiminuir.addEventListener("click", function() {
        cliques--;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnZerar.addEventListener("click", function() {
        cliques = 0;
        txtContador.textContent = cliques;
        atualizarCor();
    });
</script>