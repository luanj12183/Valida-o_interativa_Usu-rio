@{
    Layout = null;
    ViewData["Title"] = "Contador Interativo";
}

<style>
    /* 1. SEPARA O MENU LATERAL DO RESTO DO MUNDO */
    .abas-navegacao {
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
        position: fixed !important;
        top: 40px !important;
        left: 40px !important;
        z-index: 99999 !important;
    }

    .abas-navegacao a {
        text-decoration: none;
        color: #777;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-align: left;    
    }

    .abas-navegacao a.ativa {
        background-color: #e0e5e4;
        color: #333;
    }

    .abas-navegacao a:hover:not(.ativa) {
        background-color: #eaeaea;
        color: #007bff;
    }

    /* 2. CLASSES DE CORES DO NÚMERO */
    .num-neutro { color: #333333 !important; }   
    .num-positivo { color: #28a745 !important; } 
    .num-negativo { color: #dc3545 !important; } 

    /* 3. BOTÕES DO SEU PRINT */
    .grupo-botoes {
        display: flex !important;
        gap: 10px !important;
        margin-top: 20px !important;
    }

    .btn-contador {
        padding: 10px 20px !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important;
        font-weight: 500 !important;
        font-size: 16px !important;
        cursor: pointer !important;
        transition: background-color 0.2s;
    }

    .btn-azul { background-color: #007bff !important; }
    .btn-azul:hover { background-color: #0069d9 !important; }

    .btn-cinza { background-color: #6c757d !important; }
    .btn-cinza:hover { background-color: #5a6268 !important; }

    /* 4. A REDOMA QUE ARRASA QUALQUER BLOQUEIO DO ASP.NET */
    .bloco-central-absoluto {
        position: fixed !important;
        /* Define as bordas grudadas nos limites do monitor */
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        /* Ignora margens externas */
        margin: auto !important; 
        /* Cria o tamanho perfeito do seu print no centro */
        width: 400px !important;
        height: 250px !important;
        
        /* Centraliza o número e os botões internamente */
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        align-items: center !important;
        z-index: 88888 !important;
    }

    #txtContador { 
        font-size: 96px !important; 
        font-weight: bold !important; 
        margin: 0 !important;
        line-height: 1 !important;
    }
</style>

<div class="abas-navegacao">
    <a href="/">📄 Cadastro</a>
    <a href="/Home/Contador" class="ativa">🔢 Contador</a>
</div>

<div class="bloco-central-absoluto">
    <div id="txtContador" class="num-neutro">0</div>

    <div class="grupo-botoes">
        <button class="btn-contador btn-azul" id="btnSomar">Incrementar</button>
        <button class="btn-contador btn-azul" id="btnDiminuir">Decrementar</button>
        <button class="btn-contador btn-cinza" id="btnZerar">Zerar</button>
    </div>
</div>

<script>
    let cliques = 0;
    const txtContador = document.getElementById("txtContador");
    const btnSomar = document.getElementById("btnSomar");
    const btnDiminuir = document.getElementById("btnDiminuir");
    const btnZerar = document.getElementById("btnZerar");

    function atualizarCor() {
        txtContador.classList.remove("num-neutro", "num-positivo", "num-negativo");

        if (cliques > 0) {
            txtContador.classList.add("num-positivo");
        } else if (cliques < 0) {
            txtContador.classList.add("num-negativo");
        } else {
            txtContador.classList.add("num-neutro");
        }
    }

    btnSomar.addEventListener("click", function() {
        cliques++;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnDiminuir.addEventListener("click", function() {
        cliques--;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnZerar.addEventListener("click", function() {
        cliques = 0;
        txtContador.textContent = cliques;
        atualizarCor();
    });
</script>