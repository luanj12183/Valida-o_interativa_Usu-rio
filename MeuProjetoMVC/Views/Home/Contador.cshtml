@{
    Layout = null;
    ViewData["Title"] = "Contador Interativo";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7f6;
        margin: 0;
        min-height: 100vh; 
        display: flex;
        flex-direction: column;
        justify-content: center; 
        align-items: center;     
        position: relative; 
        box-sizing: border-box;
    }

    .abas-navegacao {
        display: flex;
        flex-direction: column;
        gap: 8px;
        position: absolute;
        top: 40px;
        left: 40px;
    }

    .abas-navegacao a {
        text-decoration: none;
        color: #777;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-align: left;    
    }

    .abas-navegacao a.ativa {
        background-color: #e0e5e4;
        color: #333;
    }

    .abas-navegacao a:hover:not(.ativa) {
        background-color: #eaeaea;
        color: #007bff;
    }

    #txtContador { 
        font-size: 96px; 
        font-weight: bold; 
        margin-bottom: 20px; 
        margin-top: 0;     
        transition: color 0.3s ease;
        line-height: 1;    
    }

    .num-neutro { color: #333333; }   
    .num-positivo { color: #28a745; } 
    .num-negativo { color: #dc3545; } 

    .grupo-botoes {
        display: flex;
        gap: 10px;
    }

    .btn-contador {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 500;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-azul { background-color: #007bff; }
    .btn-azul:hover { background-color: #0069d9; }

    .btn-cinza { background-color: #6c757d; }
    .btn-cinza:hover { background-color: #5a6268; }
</style>

<div class="abas-navegacao">
    <a href="/">📄 Cadastro</a>
    <a href="/Home/Contador" class="ativa">🔢 Contador</a>
</div>

<div id="txtContador" class="num-neutro">0</div>

<div class="grupo-botoes">
    <button class="btn-contador btn-azul" id="btnSomar">Incrementar</button>
    <button class="btn-contador btn-azul" id="btnDiminuir">Decrementar</button>
    <button class="btn-contador btn-cinza" id="btnZerar">Zerar</button>
</div>

<script>
    let cliques = 0;
    const txtContador = document.getElementById("txtContador");
    const btnSomar = document.getElementById("btnSomar");
    const btnDiminuir = document.getElementById("btnDiminuir");
    const btnZerar = document.getElementById("btnZerar");

    function atualizarCor() {
        txtContador.classList.remove("num-neutro", "num-positivo", "num-negativo");

        if (cliques > 0) {
            txtContador.classList.add("num-positivo");
        } else if (cliques < 0) {
            txtContador.classList.add("num-negativo");
        } else {
            txtContador.classList.add("num-neutro");
        }
    }

    btnSomar.addEventListener("click", function() {
        cliques++;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnDiminuir.addEventListener("click", function() {
        cliques--;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnZerar.addEventListener("click", function() {
        cliques = 0;
        txtContador.textContent = cliques;
        atualizarCor();
    });
</script>