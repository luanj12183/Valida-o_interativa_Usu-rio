@{
    Layout = null;
    ViewData["Title"] = "Contador Interativo";
}

<style>
    /* 1. RESET TOTAL DA TELA PARA EVITAR HERANÇAS DO ASP.NET */
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100vh !important;
        background-color: #f4f7f6 !important;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow: hidden !important; /* Evita que barras de rolagem empurrem o conteúdo */
    }

    /* 2. MENU LATERAL ESQUERDO (Ancorado sem interferir em nada) */
    .abas-navegacao {
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
        position: fixed !important; /* FIXED garante que ele ignore o resto da página */
        top: 40px !important;
        left: 40px !important;
        z-index: 9999 !important;
    }

    .abas-navegacao a {
        text-decoration: none;
        color: #777;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-align: left;    
    }

    .abas-navegacao a.ativa {
        background-color: #e0e5e4;
        color: #333;
    }

    .abas-navegacao a:hover:not(.ativa) {
        background-color: #eaeaea;
        color: #007bff;
    }

    /* 3. CORES DO NÚMERO */
    .num-neutro { color: #333333; }   
    .num-positivo { color: #28a745; } 
    .num-negativo { color: #dc3545; } 

    /* 4. OS BOTÕES DO SEU PRINT */
    .grupo-botoes {
        display: flex !important;
        gap: 10px !important;
    }

    .btn-contador {
        padding: 10px 20px;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 500;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-azul { background-color: #007bff; }
    .btn-azul:hover { background-color: #0069d9; }

    .btn-cinza { background-color: #6c757d; }
    .btn-cinza:hover { background-color: #5a6268; }

    /* 5. A CAIXA QUE SOBERANA QUE COMANDA O CENTRO DO MONITOR */
    .tela-inteira-centro {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important; /* Centro vertical */
        align-items: center !important;     /* Centro horizontal */
        z-index: 100 !important;
        pointer-events: none; /* Deixa cliques passarem se necessário */
    }

    /* Elementos dentro do centro voltam a aceitar cliques */
    .tela-inteira-centro #txtContador, 
    .tela-inteira-centro .grupo-botoes {
        pointer-events: auto;
    }

    #txtContador { 
        font-size: 96px; 
        font-weight: bold; 
        margin-bottom: 30px; 
        margin-top: 0;
        transition: color 0.3s ease;
        line-height: 1;
    }
</style>

<div class="abas-navegacao">
    <a href="/">📄 Cadastro</a>
    <a href="/Home/Contador" class="ativa">🔢 Contador</a>
</div>

<div class="tela-inteira-centro">
    <div id="txtContador" class="num-neutro">0</div>

    <div class="grupo-botoes">
        <button class="btn-contador btn-azul" id="btnSomar">Incrementar</button>
        <button class="btn-contador btn-azul" id="btnDiminuir">Decrementar</button>
        <button class="btn-contador btn-cinza" id="btnZerar">Zerar</button>
    </div>
</div>

<script>
    let cliques = 0;
    const txtContador = document.getElementById("txtContador");
    const btnSomar = document.getElementById("btnSomar");
    const btnDiminuir = document.getElementById("btnDiminuir");
    const btnZerar = document.getElementById("btnZerar");

    function atualizarCor() {
        txtContador.classList.remove("num-neutro", "num-positivo", "num-negativo");

        if (cliques > 0) {
            txtContador.classList.add("num-positivo");
        } else if (cliques < 0) {
            txtContador.classList.add("num-negativo");
        } else {
            txtContador.classList.add("num-neutro");
        }
    }

    btnSomar.addEventListener("click", function() {
        cliques++;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnDiminuir.addEventListener("click", function() {
        cliques--;
        txtContador.textContent = cliques;
        atualizarCor();
    });

    btnZerar.addEventListener("click", function() {
        cliques = 0;
        txtContador.textContent = cliques;
        atualizarCor();
    });
</script>