@model MeuProjetoMVC.Models.UsuarioViewModel

@{
    ViewData["Title"] = "Cadastro de Usuário";
}

<div class="text-center">
    <h2 class="display-4">Cadastro de Usuário</h2>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <form id="meuformulario" asp-controller="Home" asp-action="Cadastrar" method="post">

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label">Nome:</label>
                <input type="text" id="nome" asp-for="Nome" class="form-control">
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label">Email:</label>
                <input type="text" id="email" asp-for="Email" class="form-control">
            </div>

            <div class="form-group mb-3">
                <label asp-for="Idade" class="form-label">Idade:</label>
                <input type="number" id="idade" asp-for="Idade" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar</button>
            </form>

            <p id="erro" style="color: red; font-weight: bold; margin-top: 15px; text-align: center;"></p>
    </div>
</div>    

@section Scripts {
    <script src="~/js/validacao.js"></script>
}